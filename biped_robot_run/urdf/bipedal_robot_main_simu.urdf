      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="right_foot_1">
    <inertial>
      <origin xyz="0.032399565575572636 -0.014993048986541774 -0.03195045853114886" rpy="0 0 0"/>
      <mass value="0.322074"/>
      <inertia ixx="1.469000e-04" iyy="8.560000e-04" izz="9.152000e-04"
         ixy="-1.750600e-08" iyz="-2.040000e-10" ixz="4.865124e-05"/>

    </inertial>
    <visual>
      <origin xyz="0.0 0.147205 0.759849" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/right_foot_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.147205 0.759849" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/right_foot_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>


  <!-- 왼쪽 다리 -->
  <joint name="torso_imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="torso_imu"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="left_hip_pitch" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 0.089761 -0.081437"/>
    <parent link="base_link"/>
    <child link="left_hip_pitch_1"/>
    <axis xyz="-0.0 0.965926 -0.258819"/>
    <limit
      lower="-1.4"
      upper="1.4"
      effort = "48"
      velocity = "100"/>
  </joint>
  <joint name="left_hip_roll" type="continuous">
    <origin rpy="0 0 0" xyz="0.0445 0.072444 -0.019412"/>
    <parent link="left_hip_pitch_1"/>
    <child link="left_link2_hip_1"/>
    <axis xyz="1.0 0.0 -0.0"/>
    <limit
      lower="-0.262"
      upper="1.05"
      effort = "48"
      velocity = "100"/>
  </joint>
  <joint name="left_hip_yaw" type="continuous">
    <origin rpy="0 0 0" xyz="-0.0445 0.0 -0.1205"/>
    <parent link="left_link2_hip_1"/>
    <child link="left_thigh_1"/>
    <axis xyz="-0.0 0.0 1.0"/>
    <limit
      lower="-0.698"
      upper="0.698"
      effort = "18"
      velocity = "100"/>
  </joint>
    <joint name="left_knee" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 0.017 -0.2035"/>
    <parent link="left_thigh_1"/>
    <child link="left_shank_1"/>
    <axis xyz="-0.0 1.0 0.0"/>
    <limit
      lower="0"
      upper="2.09"
      effort = "48"
      velocity = "100"/>
  </joint>
  <joint name="left_ankle_roll" type="continuous">
    <origin rpy="0 0 0" xyz="0.019 -0.017 -0.335"/>
    <parent link="left_shank_1"/>
    <child link="left_ankle_roll_1"/>
    <axis xyz="1.0 -0.0 0.0"/>
    <limit
      lower="-0.5"
      upper="0.5"
      effort = "20"
      velocity = "100"/>
  </joint>
  <joint name="left_ankle_pitch" type="continuous">
    <origin xyz="-0.019 -0.015 0.0" rpy="0 0 0"/>
    <parent link="left_ankle_roll_1"/>
    <child link="left_foot_1"/>
    <axis xyz="-0.0 1.0 -0.0"/>
    <limit
    lower="-0.5"
      upper="0.5"
      effort = "20"
      velocity = "100"/>
  </joint>

  <!-- 오른쪽 다리 --> 
  <joint name="right_hip_pitch" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 -0.089761 -0.081437"/>
    <parent link="base_link"/>
    <child link="right_hip_pitch_1"/>
    <axis xyz="0.0 0.965926 0.258819"/>
    <limit
      lower="-1.4"
      upper="1.4"
      effort = "48"
      velocity = "100"/>
  </joint>
  <joint name="right_hip_roll" type="continuous">
    <origin rpy="0 0 0" xyz="0.0445 -0.072444 -0.019412"/>
    <parent link="right_hip_pitch_1"/>
    <child link="right_link2_hip_1"/>
    <axis xyz="1.0 0.0 0.0"/>
    <limit
      lower="-1.05"
      upper="0.262"
      effort = "48"
      velocity = "100"/>
  </joint>
  <joint name="right_hip_yaw" type="continuous">
    <origin rpy="0 0 0" xyz="-0.0445 0.0 -0.1205"/>
    <parent link="right_link2_hip_1"/>
    <child link="right_thigh_1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit
      lower="-0.698"
      upper="0.698"
      effort = "18"
      velocity = "100"/>
  </joint>

  <joint name="right_knee" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 -0.017 -0.2035"/>
    <parent link="right_thigh_1"/>
    <child link="right_shank_1"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit
      lower="0"
      upper="2.09"
      effort = "48"
      velocity = "100"/>
  </joint>
  <joint name="right_ankle_roll" type="continuous">
    <origin rpy="0 0 0" xyz="0.019 0.017 -0.335"/>
    <parent link="right_shank_1"/>
    <child link="right_ankle_roll_1"/>
    <axis xyz="1.0 -0.0 -0.0"/>
    <limit
      lower="-0.5"
      upper="0.5"
      effort = "20"
      velocity = "100"/>
  </joint>
  <joint name="right_ankle_pitch" type="continuous">
    <origin xyz="-0.019 0.015 0.0" rpy="0 0 0"/>
    <parent link="right_ankle_roll_1"/>
    <child link="right_foot_1"/>
    <axis xyz="-0.0 1.0 -0.0"/>
    <limit
    lower="-0.5"
    upper="0.5"
    effort = "20"
    velocity = "100"/>
  </joint>
  
  <ros2_control name="MujocoSystem" type="mujoco_ros2_control/MujocoSystem">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
    </hardware>
      <joint name="left_hip_pitch">
        <param name="min">-1.05</param> <!--joint position limit-->
        <param name="max">1.05</param> <!--joint position limit-->
        <param name="position_kp">650.0</param> <!--define kp gain of the pid controller-->
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/> <!--define command interface, to use pid controller, need to include _pid in the name-->
        <state_interface name="position"/> <!--require position interface/feedback-->
        <state_interface name="velocity"/> <!--require velocity interface/feedback-->
        <state_interface name="effort"/>
      </joint>
      <joint name="left_hip_roll">       
        <param name="min">-0.35</param>
        <param name="max">0.8</param>
        <param name="position_kp">600.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>
        <command_interface name="position_pid"/>       
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_hip_yaw">        
        <param name="min">-0.8</param>
        <param name="max">0.8</param>
        <param name="position_kp">150.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_knee">        
        <param name="min">0</param>
        <param name="max">2.09</param>
        <param name="position_kp">350.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_ankle_roll">
        <param name="min">-0.34</param>
        <param name="max">0.34</param>
        <param name="position_kp">250.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_ankle_pitch">        
        <param name="min">-0.34</param>
        <param name="max">0.34</param>
        <param name="position_kp">250.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>
        <command_interface name="position_pid"/>        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>


      <joint name="right_hip_pitch">
        <param name="min">-1.05</param> <!--joint position limit-->
        <param name="max">1.05</param> <!--joint position limit-->
        <param name="position_kp">650.0</param> <!--define kp gain of the pid controller-->
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/> <!--define command interface, to use pid controller, need to include _pid in the name-->
        <state_interface name="position"/> <!--require position interface/feedback-->
