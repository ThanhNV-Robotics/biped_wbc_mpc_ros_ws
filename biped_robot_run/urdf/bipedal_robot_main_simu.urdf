<?xml version="1.0" ?>
<robot name="Bipedal_Robot">
  <mujoco>
    <compiler meshdir="meshes/" balanceinertia="true" discardvisual="false"/>
  </mujoco>
  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>
  <!-- <link name="world"/> -->
  <link name="base_link">
    <inertial>
      <!-- COM (m) converted from 0.021 mm, 0.011 mm, -8.802 mm -->
      <origin xyz="2.1e-05 1.1e-05 -0.008802" rpy="0 0 0"/>
      <mass value="5.668792"/>
      <inertia ixx="0.1335"
              ixy="-7.511712e-06"
              ixz="8.48132e-06"
              iyy="0.1017"
              iyz="8.596425e-06"
              izz="0.06263"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>  
  </link>

  <link name="torso_imu">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
  </link>

  <!-- <link name="torso_magnometer">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
  </link> -->

  <link name="left_hip_pitch_1">
    <inertial>
      <origin xyz="5.535e-03 5.735e-02 -1.4768e-02" rpy="0 0 0"/>
      <mass   value="1.764294"/>
      <inertia
              ixx="0.003317"
              ixy="-0.0001465"
              ixz="4.49051e-05"
              iyy="0.002368"
              iyz="0.0003016"
              izz="0.003408"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.0 -0.089761 0.081437"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/left_hip_pitch_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="left_link2_hip_1">
    <inertial>
      <origin xyz="-0.044636 -1.6e-05 -0.073241" rpy="0 0 0"/>
      <mass   value="1.291801"/>
      <inertia
          ixx="0.002359"
          ixy="9.43829e-07"
          ixz="-9.2706e-07"
          iyy="0.003152"
          iyz="-3.42947e-06"
          izz="0.001975"/>
