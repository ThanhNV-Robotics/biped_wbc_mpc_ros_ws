        <param name="position_kp">600.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>
        <command_interface name="position_pid"/>       
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_hip_yaw">        
        <param name="min">-0.8</param>
        <param name="max">0.8</param>
        <param name="position_kp">150.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_knee">      
        <param name="min">0</param>
        <param name="max">2.09</param>
        <param name="position_kp">350.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_ankle_roll">
        <param name="min">-0.34</param>
        <param name="max">0.34</param>
        <param name="position_kp">250.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>       
        <command_interface name="position_pid"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_ankle_pitch">        
        <param name="min">-0.34</param>
        <param name="max">0.34</param>
        <param name="position_kp">250.0</param>
        <param name="position_ki">0.0</param>
        <param name="position_kd">1.5</param>
        <param name="position_i_max">50.0</param>
        <param name="position_i_min">-50.0</param>
        <command_interface name="position_pid"/>        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
