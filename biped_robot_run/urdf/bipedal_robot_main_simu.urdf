      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/left_shank_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="left_ankle_roll_1">
    <inertial>
      <origin xyz="-0.019 0 0" rpy="0 0 0"/>
      <mass value="0.040313"/>
      <inertia ixx="3.498104000e-06"
              ixy="1.000000000e-12"
              ixz="-1.165000000e-16"
              iyy="5.125014000e-06"
              iyz="0.000000000e+00"
              izz="7.009009000e-06"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="-0.019 -0.162205 0.759849"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/left_ankle_roll_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="left_foot_1">
    <inertial>
      <origin xyz="0.032253955762776725 0.015102247849545392 -0.03191414365676737" rpy="0 0 0"/>
      <mass value="0.343229"/>
      <inertia ixx="1.546000e-04" iyy="8.770000e-04" izz="9.434000e-04"
         ixy="-9.970000e-09" iyz="4.036000e-08" ixz="5.023091e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.0 -0.147205 0.759849" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/left_foot_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>


  <!--                        오른쪽 다리                                 -->
  <link name="right_hip_pitch_1">
    <inertial>
      <origin xyz="0.005579 -0.057884 -0.014909" rpy="0 0 0"/>
      <mass value="1.751319"/>
      <inertia ixx="0.003245"
              ixy="0.000141"
              ixz="0.000043"
              iyy="0.002362"
              iyz="-0.000284"
              izz="0.003340"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.0 0.089761 0.081437"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/right_hip_pitch_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="right_link2_hip_1">
    <inertial>
      <origin xyz="-4.4009e-02 -1.7e-05 -7.2733e-02" rpy="0 0 0"/>
      <mass   value="1.263991"/>
      <inertia ixx="0.00229"
              ixy="9.32167e-07"
              ixz="-4.2678724e-05"
              iyy="0.003087"
              iyz="-3.437391e-06"
              izz="0.001938"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="-0.0445 0.162205 0.100849"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/right_link2_hip_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="right_thigh_1">
    <inertial>
      <origin xyz="-2.9e-05 0.013844 -0.165473" rpy="0 0 0"/>
      <mass value="1.851928"/>
      <inertia ixx="0.01164"
              ixy="2.38996e-06"
              ixz="-1.032991e-06"
              iyy="0.01208"
              iyz="9.596e-04"
              izz="0.002009"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.162205 0.221349"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/right_thigh_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="right_shank_1">
    <inertial>
      <!-- Center-of-mass in *world* coordinates (mm → m) -->
      <origin xyz="0.009336 0.013239 -0.163037" rpy="0 0 0"/>

      <!-- mass: 1879.221 g → kg -->
      <mass value="1.879221"/>

      <!-- inertia: values shown were in g·mm².  g → kg (×0.001) and mm² → m² (×1e-6)  ⇒ overall ×1e-9 -->
      <inertia ixx="0.01653"
               ixy="-3.5348501e-05"
               ixz="7.738e-04"
               iyy="0.01633"
               iyz="8.795e-04"
               izz="0.00148"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.179205 0.424849"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/right_shank_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="right_ankle_roll_1">
    <inertial>
      <!--  COM(World)  :  –1.001e-08 mm , –162.205 mm , –759.849 mm  -->
      <origin xyz="-0.019 0 0" rpy="0 0 0"/>
      <mass   value="0.040313"/>
      <inertia ixx="3.498104e-06"
              ixy="1.000000e-12"
              ixz="-1.165000e-16"
              iyy="5.125014e-06"
              iyz="0.000000e+00"
              izz="7.009009e-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.019 0.162205 0.759849"/>
      <geometry>
