    <visual>
      <origin rpy="0 0 0" xyz="-0.0445 -0.162205 0.100849"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/left_link2_hip_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="left_thigh_1">
    <inertial>
      <!-- CoM 위치: -0.314 mm, 148.871 mm, -387.384 mm  →  m 단위 -->
      <origin xyz="-0.000314 -0.013334 -0.166035" rpy="0 0 0"/>

      <!-- 질량: 1867.391 g → kg -->
      <mass value="1.867391"/>

      <!-- 관성 모멘트: (g·mm²)  →  kg·m²  (×10⁻⁹) -->
      <inertia ixx="0.01165"
              ixy="2.6779e-05"
              ixz="-3.2964e-05"
              iyy="0.01208"
              iyz="-9.808e-04"
              izz="0.002085"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0.0 -0.162205 0.221349"/>
      <geometry>
        <mesh filename="package://mujoco_ros2_control_demos/urdf/meshes/left_thigh_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

  </link>
  <link name="left_shank_1">
    <inertial>
      <origin xyz="0.009700 -0.013414 -0.163789" rpy="0 0 0"/>
      <mass   value="1.894225"/>
      <inertia ixx="0.016810"
               ixy="0.000031714"
               ixz="0.000844700"
               iyy="0.016630"
               iyz="-0.000889700"
