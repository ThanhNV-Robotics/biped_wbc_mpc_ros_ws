<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Material Definition -->
    <material name="silver">
        <color rgba="0.700 0.700 0.700 1.000"/>
    </material>

    <xacro:property name="pkg_share" value="$(find humanoid_hardware)"/>
    <xacro:property name="mesh_dir" value="file://${pkg_share}/urdf/meshes"/>

    <!-- link Definitions -->
    <link name="base_link">
        <inertial>
            <origin xyz="2.1e-05 1.1e-05 -0.008802" rpy="0 0 0"/>
            <mass value="5.668792"/>
            <inertia ixx="0.1335"
                    ixy="-7.511712e-06"
                    ixz="8.48132e-06"
                    iyy="0.1017"
                    iyz="8.596425e-06"
                    izz="0.06263"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/base_link_collision.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="left_hip_pitch_1">
        <inertial>
            <origin xyz="5.535e-03 5.735e-02 -1.4768e-02" rpy="0 0 0"/>
            <mass   value="1.764294"/>
            <inertia
                    ixx="0.003317"
                    ixy="-0.0001465"
                    ixz="4.49051e-05"
                    iyy="0.002368"
                    iyz="0.0003016"
                    izz="0.003408"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.0 -0.089761 0.081437"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_hip_pitch_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="-0.0 -0.089761 0.081437"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_hip_pitch_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="left_link2_hip_1">
        <inertial>
            <origin xyz="-0.044636 -1.6e-05 -0.073241" rpy="0 0 0"/>
            <mass   value="1.291801"/>
            <inertia
                ixx="0.002359"
                ixy="9.43829e-07"
                ixz="-9.2706e-07"
                iyy="0.003152"
                iyz="-3.42947e-06"
                izz="0.001975"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.0445 -0.162205 0.100849"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_link2_hip_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="-0.0445 -0.162205 0.100849"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_link2_hip_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="left_thigh_1">
        <inertial>
            <!-- CoM 위치: -0.314 mm, 148.871 mm, -387.384 mm  →  m 단위 -->
            <origin xyz="-0.000314 -0.013334 -0.166035" rpy="0 0 0"/>

            <!-- 질량: 1867.391 g → kg -->
            <mass value="1.867391"/>

            <!-- 관성 모멘트: (g·mm²)  →  kg·m²  (×10⁻⁹) -->
            <inertia ixx="0.01165"
                    ixy="2.6779e-05"
                    ixz="-3.2964e-05"
                    iyy="0.01208"
                    iyz="-9.808e-04"
                    izz="0.002085"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0.0 -0.162205 0.221349"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_thigh_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="0.0 -0.162205 0.221349"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_thigh_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="left_shank_1">
        <inertial>
            <origin xyz="0.009700 -0.013414 -0.163789" rpy="0 0 0"/>
            <mass   value="1.894225"/>
            <inertia ixx="0.016810"
                    ixy="0.000031714"
                    ixz="0.000844700"
                    iyy="0.016630"
                    iyz="-0.000889700"
                    izz="0.001510"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0.0 -0.179205 0.424849"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_shank_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="0.0 -0.179205 0.424849"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_shank_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="left_ankle_roll_1">
        <inertial>
            <origin xyz="-0.019 0 0" rpy="0 0 0"/>
            <mass value="0.040313"/>
            <inertia ixx="3.498104000e-06"
                    ixy="1.000000000e-12"
                    ixz="-1.165000000e-16"
                    iyy="5.125014000e-06"
                    iyz="0.000000000e+00"
                    izz="7.009009000e-06"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.019 -0.162205 0.759849"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_ankle_roll_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="-0.019 -0.162205 0.759849"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_ankle_roll_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="left_foot_1">
        <inertial>
            <origin xyz="0.032253955762776725 0.015102247849545392 -0.03191414365676737" rpy="0 0 0"/>
            <mass value="0.343229"/>
            <inertia ixx="1.546000e-04" iyy="8.770000e-04" izz="9.434000e-04"
                ixy="-9.970000e-09" iyz="4.036000e-08" ixz="5.023091e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.0 -0.147205 0.759849" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/left_foot_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <!-- <origin xyz="0.0 -0.147205 0.759849" rpy="0 0 0"/> -->
            <!-- <geometry>
                <mesh filename="${mesh_dir}/left_foot_1_collision.stl" scale="0.001 0.001 0.001"/>
            </geometry> -->
            <origin xyz="0.04 0.02 -0.02" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.09 0.038"/>
            </geometry>
        </collision>
    </link>

    <!--                        오른쪽 다리                                 -->
    <link name="right_hip_pitch_1">
        <inertial>
            <origin xyz="0.005579 -0.057884 -0.014909" rpy="0 0 0"/>
            <mass value="1.751319"/>
            <inertia ixx="0.003245"
                    ixy="0.000141"
                    ixz="0.000043"
                    iyy="0.002362"
                    iyz="-0.000284"
                    izz="0.003340"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.0 0.089761 0.081437"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_hip_pitch_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="-0.0 0.089761 0.081437"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_hip_pitch_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="right_link2_hip_1">
        <inertial>
            <origin xyz="-4.4009e-02 -1.7e-05 -7.2733e-02" rpy="0 0 0"/>
            <mass   value="1.263991"/>
            <inertia ixx="0.00229"
                    ixy="9.32167e-07"
                    ixz="-4.2678724e-05"
                    iyy="0.003087"
                    iyz="-3.437391e-06"
                    izz="0.001938"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.0445 0.162205 0.100849"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_link2_hip_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="-0.0445 0.162205 0.100849"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_link2_hip_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="right_thigh_1">
        <inertial>
            <origin xyz="-2.9e-05 0.013844 -0.165473" rpy="0 0 0"/>
            <mass value="1.851928"/>
            <inertia ixx="0.01164"
                    ixy="2.38996e-06"
                    ixz="-1.032991e-06"
                    iyy="0.01208"
                    iyz="9.596e-04"
                    izz="0.002009"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.162205 0.221349"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_thigh_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="0.0 0.162205 0.221349"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_thigh_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="right_shank_1">
        <inertial>
            <!-- Center-of-mass in *world* coordinates (mm → m) -->
            <origin xyz="0.009336 0.013239 -0.163037" rpy="0 0 0"/>

            <!-- mass: 1879.221 g → kg -->
            <mass value="1.879221"/>

            <!-- inertia: values shown were in g·mm².  g → kg (×0.001) and mm² → m² (×1e-6)  ⇒ overall ×1e-9 -->
            <inertia ixx="0.01653"
                    ixy="-3.5348501e-05"
                    ixz="7.738e-04"
                    iyy="0.01633"
                    iyz="8.795e-04"
                    izz="0.00148"/>
        </inertial>

        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.179205 0.424849"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_shank_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="0.0 0.179205 0.424849"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_shank_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="right_ankle_roll_1">
        <inertial>
            <!--  COM(World)  :  –1.001e-08 mm , –162.205 mm , –759.849 mm  -->
            <origin xyz="-0.019 0 0" rpy="0 0 0"/>
            <mass   value="0.040313"/>
            <inertia ixx="3.498104e-06"
                    ixy="1.000000e-12"
                    ixz="-1.165000e-16"
                    iyy="5.125014e-06"
                    iyz="0.000000e+00"
                    izz="7.009009e-06"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.019 0.162205 0.759849"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_ankle_roll_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <!-- <collision>
            <origin rpy="0 0 0" xyz="-0.019 0.162205 0.759849"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_ankle_roll_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision> -->
    </link>

    <link name="right_foot_1">
        <inertial>
            <origin xyz="0.032399565575572636 -0.014993048986541774 -0.03195045853114886" rpy="0 0 0"/>
            <mass value="0.322074"/>
            <inertia ixx="1.469000e-04" iyy="8.560000e-04" izz="9.152000e-04"
                ixy="-1.750600e-08" iyz="-2.040000e-10" ixz="4.865124e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.147205 0.759849" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_foot_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <!-- <origin xyz="0.0 0.147205 0.759849" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/right_foot_1_collision.stl" scale="0.001 0.001 0.001"/>
            </geometry> -->
            <origin xyz="0.04 -0.02 -0.02" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.09 0.038"/>
            </geometry>
        </collision>
    </link>

    <link name="imu_link">
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    </link>
    
    <!-- 왼쪽 다리 -->
    <joint name="left_hip_pitch" type="continuous">
        <origin rpy="0 0 0" xyz="0.0 0.089761 -0.081437"/>
        <parent link="base_link"/>
        <child link="left_hip_pitch_1"/>
        <axis xyz="-0.0 0.965926 -0.258819"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="left_hip_roll" type="continuous">
        <origin rpy="0 0 0" xyz="0.0445 0.072444 -0.019412"/>
        <parent link="left_hip_pitch_1"/>
        <child link="left_link2_hip_1"/>
        <axis xyz="1.0 0.0 -0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="left_hip_yaw" type="continuous">
        <origin rpy="0 0 0" xyz="-0.0445 0.0 -0.1205"/>
        <parent link="left_link2_hip_1"/>
        <child link="left_thigh_1"/>
        <axis xyz="-0.0 0.0 1.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="left_knee" type="continuous">
        <origin rpy="0 0 0" xyz="0.0 0.017 -0.2035"/>
        <parent link="left_thigh_1"/>
        <child link="left_shank_1"/>
        <axis xyz="-0.0 1.0 0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="left_ankle_roll" type="continuous">
        <origin rpy="0 0 0" xyz="0.019 -0.017 -0.335"/>
        <parent link="left_shank_1"/>
        <child link="left_ankle_roll_1"/>
        <axis xyz="-1.0 -0.0 0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="left_ankle_pitch" type="continuous">
        <origin xyz="-0.019 -0.015 0.0" rpy="0 0 0"/>
        <parent link="left_ankle_roll_1"/>
        <child link="left_foot_1"/>
        <axis xyz="-0.0 1.0 -0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>

    <!-- 오른쪽 다리 --> 
    <joint name="right_hip_pitch" type="continuous">
        <origin rpy="0 0 0" xyz="0.0 -0.089761 -0.081437"/>
        <parent link="base_link"/>
        <child link="right_hip_pitch_1"/>
        <axis xyz="0.0 0.965926 0.258819"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="right_hip_roll" type="continuous">
        <origin rpy="0 0 0" xyz="0.0445 -0.072444 -0.019412"/>
        <parent link="right_hip_pitch_1"/>
        <child link="right_link2_hip_1"/>
        <axis xyz="1.0 0.0 0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
        <joint name="right_hip_yaw" type="continuous">
        <origin rpy="0 0 0" xyz="-0.0445 0.0 -0.1205"/>
        <parent link="right_link2_hip_1"/>
        <child link="right_thigh_1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
    <joint name="right_knee" type="continuous">
        <origin rpy="0 0 0" xyz="0.0 -0.017 -0.2035"/>
        <parent link="right_thigh_1"/>
        <child link="right_shank_1"/>
        <axis xyz="0.0 1.0 0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
    <joint name="right_ankle_roll" type="continuous">
        <origin rpy="0 0 0" xyz="0.019 0.017 -0.335"/>
        <parent link="right_shank_1"/>
        <child link="right_ankle_roll_1"/>
        <axis xyz="-1.0 -0.0 -0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>
    <joint name="right_ankle_pitch" type="continuous">
        <origin xyz="-0.019 0.015 0.0" rpy="0 0 0"/>
        <parent link="right_ankle_roll_1"/>
        <child link="right_foot_1"/>
        <axis xyz="-0.0 1.0 -0.0"/>
        <dynamics friction="0.5" damping="1.0"/>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        
        <joint name="left_hip_pitch">
            <param name="motor_id">10</param>
            <param name="rpi_id">2</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="left_hip_roll">
            <param name="motor_id">20</param>
            <param name="rpi_id">2</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="left_hip_yaw">
            <param name="motor_id">30</param>
            <param name="rpi_id">2</param>
            <param name="direction">-1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="left_knee">
            <param name="motor_id">40</param>
            <param name="rpi_id">2</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="left_ankle_roll">
            <param name="motor_id">50</param>
            <param name="rpi_id">2</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="left_ankle_pitch">
            <param name="motor_id">60</param>
            <param name="rpi_id">2</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_hip_pitch">
            <param name="motor_id">70</param>
            <param name="rpi_id">1</param>
            <param name="direction">-1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_hip_roll">
            <param name="motor_id">80</param>
            <param name="rpi_id">1</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_hip_yaw">
            <param name="motor_id">90</param>
            <param name="rpi_id">1</param>
            <param name="direction">-1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_knee">
            <param name="motor_id">100</param>
            <param name="rpi_id">1</param>
            <param name="direction">-1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_ankle_roll">
            <param name="motor_id">110</param>
            <param name="rpi_id">1</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_ankle_pitch">
            <param name="motor_id">120</param>
            <param name="rpi_id">1</param>
            <param name="direction">1</param>
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <sensor name="imu_sensor">
            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="orientation.w"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
        </sensor>

    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find humanoid_hardware)/config/humanoid_controllers_gz.yaml</parameters>
        </plugin>
        <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <visualize>false</visualize>
            <!-- <topic>/imu</topic> -->
        </sensor>
    </gazebo>

    <xacro:macro name="joint_transmission" params="joint_name">
        <transmission name="${joint_name}_transmission">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${joint_name}">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${joint_name}_motor">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>

</robot>