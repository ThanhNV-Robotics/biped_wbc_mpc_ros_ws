<!-- Visualization scene for testLIPTaskPlanner (no physics): every marker is a mocap body whose
     position the test sets each cycle from LIPTaskPlanner. Same elements as
     tsid_examples/python/SimDraw.py; the rod, legs and trajectories are drawn by the test. -->
<mujoco model="LIP_model">
  <option gravity="0 0 0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-60" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <!-- 0.1 m grid (texrepeat over the 10 m plane) -->
    <texture name="grid" type="2d" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="100 100" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.01" pos="2 0 0" material="grid" contype="0" conaffinity="0"/>

    <!-- CoM (blue mass point) and its ground shadow -->
    <body name="com" mocap="true" pos="0 0 0.45">
      <geom type="sphere" size="0.03" rgba="0.25 0.41 0.88 1" contype="0" conaffinity="0"/>
    </body>
    <body name="com_shadow" mocap="true" pos="0 0 0.001">
      <geom type="cylinder" size="0.015 0.001" rgba="0.39 0.58 0.93 0.5" contype="0" conaffinity="0"/>
    </body>

    <!-- ZMP (crimson square) with the foot sole outline around it -->
    <body name="zmp" mocap="true" pos="0 0 0.002">
      <geom type="box" size="0.012 0.012 0.002" rgba="0.86 0.08 0.24 1" contype="0" conaffinity="0"/>
      <geom type="box" size="0.06 0.03 0.0005" pos="0.02 0 0" rgba="1 0 0 0.25" contype="0" conaffinity="0"/>
    </body>

    <!-- capture point (red cross) -->
    <body name="cp" mocap="true" pos="0 0 0.003">
      <geom type="box" size="0.02 0.004 0.002" euler="0 0 45" rgba="1 0 0 1" contype="0" conaffinity="0"/>
      <geom type="box" size="0.02 0.004 0.002" euler="0 0 -45" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>

    <!-- feet (contact frames): left green, right orange -->
    <body name="left_foot" mocap="true" pos="0 0.135 0">
      <geom type="sphere" size="0.02" rgba="0.13 0.55 0.13 1" contype="0" conaffinity="0"/>
    </body>
    <body name="right_foot" mocap="true" pos="0 -0.135 0">
      <geom type="sphere" size="0.02" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
