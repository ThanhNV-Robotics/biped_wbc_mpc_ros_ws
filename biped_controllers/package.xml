<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>biped_controllers</name>
  <version>0.0.0</version>
  <description>ros2_control controllers for the 12-motor biped (joint_jogging_controller; later the WBC)</description>
  <maintainer email="thanhnguyenvan0596@gmail.com">humanoid</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>biped_wbc_core</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
