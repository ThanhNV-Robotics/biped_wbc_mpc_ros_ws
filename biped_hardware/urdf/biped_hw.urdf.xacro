<?xml version="1.0"?>
<!--
  Robot model + ros2_control block for the real robot (biped_hardware/BipedSystem).

  motor_index = index into wbc_protocol.h motors[] (CAN ID order):
    0..5  left  10 hip pitch, 20 hip roll, 30 hip yaw, 40 knee, 50 ankle upper, 60 ankle lower
    6..11 right 70 ... 120 (same joint order)
  The ankle roll joint carries the upper motor, the ankle pitch joint the lower motor;
  BipedSystem maps the motor pair to roll / pitch with ankle_kinematics.hpp.

  direction = +1 / -1 so that a positive motor angle matches the positive URDF joint angle.
  Verified on the robot 2026-10-23 by moving each joint by hand against RViz (step 3).

  kp / kd come from config/joint_gains.yaml (argument `gains`), section `robot`, for the robot and
  the simulation alike (a file without that section is used as is): written to the motors when the
  hardware is activated, then fixed (PVT commands only).

  use_sim:=true replaces BipedSystem with the MuJoCo simulation (mujoco_ros2_control in PVT mode,
  see biped_bringup/launch/sim.launch.py). Same component name, joints, interfaces and gains, so the controllers
  and controllers.yaml are unchanged. The sim joints are serial (the ankle linkage is not
  simulated): the ankle kp / kd act directly on the roll / pitch joints there. motor_index /
  direction are not used by the sim.
-->
<robot name="biped" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="model" default="v2_biped_robot_12dof.urdf"/>
  <xacro:arg name="board_ip" default="192.168.10.10"/>
  <xacro:arg name="board_port" default="9999"/>
  <xacro:arg name="timeout_cycles" default="10"/>
  <xacro:arg name="gains" default="$(find biped_hardware)/config/joint_gains.yaml"/>
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="mujoco_scene" default="scene_hanging_12dof_v2.xml"/>
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="initial_keyframe" default="hang"/>
  <!-- sim: one physics step per control cycle (tsid_ref.launch.py), false = real-time physics -->
  <xacro:arg name="lockstep" default="false"/>
  <xacro:arg name="lockstep_steps" default="1"/>  <!-- physics steps per control cycle (500 Hz: 2) -->

  <!-- gains: section `robot` of the file (also in the simulation), or the whole file if it has no
       such section (joint-space gains as they are) -->
  <xacro:property name="gains_file" value="${xacro.load_yaml('$(arg gains)')}"/>
  <xacro:property name="robot_gains" value="${'robot' in gains_file}"/>
  <xacro:property name="gains" value="${gains_file['robot'] if robot_gains else gains_file}"/>

  <xacro:include filename="$(find biped_description)/urdf/$(arg model)"/>

  <xacro:macro name="hw_joint" params="name motor_index direction">
    <joint name="${name}">
      <param name="motor_index">${motor_index}</param>
      <param name="direction">${direction}</param>
      <param name="kp">${gains[name]['kp']}</param>
      <param name="kd">${gains[name]['kd']}</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="BipedSystem" type="system">
    <xacro:if value="$(arg use_sim)">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(find biped_description)/mjcf/$(arg mujoco_scene)</param>
        <param name="headless">$(arg headless)</param>
        <param name="initial_keyframe">$(arg initial_keyframe)</param>
        <!-- Motor drives + board as on the robot: fixed kp / kd, PVT commands, disabled until
             activated, command timeout -> damping 1 s -> disabled.
             Timeout 100 ms in sim (the robot's firmware uses 20 ms): more tolerant of slow
             cycles while the controller is being developed. -->
        <param name="pvt_mode">true</param>
        <!-- section robot: the ankle kp / kd are the robot's motor-space gains, both sim ankle joints
             take the sum of the two ankle motors' gains -->
        <param name="parallel_ankles">${'true' if robot_gains else 'false'}</param>
        <param name="command_timeout">0.1</param>
        <param name="damping_kd">1.0</param>
        <param name="damping_duration">1.0</param>
        <!-- ground-truth foot contact forces on /simulator/foot_contact_force (as tsid_examples'
             Cheat_StateEstimator: contact = vertical force > 20 N) -->
        <param name="contact_force_bodies">left_ankle_pitch_link right_ankle_pitch_link</param>
        <!-- lock-step: the physics steps once per controller manager write (its period must be
             the MJCF timestep), as a simulation with the controller in the physics loop -->
        <param name="lockstep">$(arg lockstep)</param>
        <param name="lockstep_steps">$(arg lockstep_steps)</param>

        <param name="orientation_mjcf_suffix">-quat</param>
        <param name="angular_velocity_mjcf_suffix">-gyro</param>
        <param name="linear_acceleration_mjcf_suffix">-baseAcc</param>
      </hardware>

    </xacro:if>
    <xacro:unless value="$(arg use_sim)">
      <hardware>
        <plugin>biped_hardware/BipedSystem</plugin>
        <param name="board_ip">$(arg board_ip)</param>
        <param name="board_port">$(arg board_port)</param>
        <param name="timeout_cycles">$(arg timeout_cycles)</param>
      </hardware>
    </xacro:unless>

    <xacro:hw_joint name="left_hip_pitch_joint"    motor_index="0"  direction="1"/>
    <xacro:hw_joint name="left_hip_roll_joint"     motor_index="1"  direction="1"/>
    <xacro:hw_joint name="left_hip_yaw_joint"      motor_index="2"  direction="-1"/>
    <xacro:hw_joint name="left_knee_pitch_joint"   motor_index="3"  direction="1"/>
    <xacro:hw_joint name="left_ankle_roll_joint"   motor_index="4"  direction="1"/>
    <xacro:hw_joint name="left_ankle_pitch_joint"  motor_index="5"  direction="1"/>

    <xacro:hw_joint name="right_hip_pitch_joint"   motor_index="6"  direction="-1"/>
    <xacro:hw_joint name="right_hip_roll_joint"    motor_index="7"  direction="1"/>
    <xacro:hw_joint name="right_hip_yaw_joint"     motor_index="8"  direction="-1"/>
    <xacro:hw_joint name="right_knee_pitch_joint"  motor_index="9"  direction="-1"/>
    <xacro:hw_joint name="right_ankle_roll_joint"  motor_index="10" direction="1"/>
    <xacro:hw_joint name="right_ankle_pitch_joint" motor_index="11" direction="1"/>
  
    <xacro:if value="$(arg use_sim)">
      <sensor name="imu">
        <param name="mujoco_type">imu</param>
        <param name="mujoco_sensor_name">baselink</param>
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </xacro:if>

  
  </ros2_control>

</robot>
