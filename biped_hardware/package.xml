<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>biped_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface for the 12-motor biped behind the NUCLEO-H755 FDCAN/UDP bridge</description>
  <maintainer email="thanhnguyenvan0596@gmail.com">humanoid</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>urdf</depend>

  <!-- biped_hw.urdf.xacro includes the URDF of biped_description; the sim branch loads the
       MuJoCo plugin. Launch files: biped_bringup -->
  <exec_depend>biped_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
