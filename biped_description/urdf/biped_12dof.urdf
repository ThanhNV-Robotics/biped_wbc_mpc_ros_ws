  <!-- ROS2 Control Configuration -->
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>

      <!-- Conditional mujoco_model parameter based on use_pid -->
      <xacro:if value="$(arg use_pid)">
        <param name="pids_config_file">$(find biped_description)/config/joint_pd_gain.yaml</param>
      </xacro:if>

      <xacro:unless value="$(arg use_mjcf_from_topic)">
        <param name="mujoco_model">$(find biped_description)/mjcf/biped_robot_12dof.xml</param>
      </xacro:unless>

      <!-- Uncomment this to use the keyframe from shown file as the starting configuration. -->
      <!-- <param name="override_start_position_file">$(find mujoco_ros2_control_demos)/config/start_positions.xml</param> -->

      <!-- Override the slowdown settings in the Simulate App and run at 3x speed -->
      <param name="sim_speed_factor">1.0</param>

      <!-- Uncomment to start the simulation at a specific keyframe defined in the MJCF -->
      <!-- <param name="initial_keyframe">start_90</param> -->

      <!-- If set to true, will not launch the Simulate App window -->
      <param name="headless">$(arg headless)</param>

    </hardware>
    <joint name="left_hip_pitch_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

      <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="left_hip_roll_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="left_hip_yaw_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="left_knee_pitch_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="left_ankle_roll_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="left_ankle_pitch_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="right_hip_pitch_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="right_hip_roll_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="right_hip_yaw_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="right_knee_pitch_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="right_ankle_roll_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <joint name="right_ankle_pitch_joint">
      <command_interface name="position"/>
      <xacro:if value="$(arg use_pid)">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>

       <!-- Effort and torque are semantically different but map to the same underlying data. -->
      <state_interface name="effort"/>
      <state_interface name="torque"/>
    </joint>

    <!-- IMU Sensor -->
    <sensor name="torso_imu">
      <param name="mujoco_type">imu</param>
      <!-- The mujoco_sensor_name is the prefix for the sensors in MJCF (torso_quat, torso_accel, torso_gyro) -->
      <param name="mujoco_sensor_name">torso</param>
      <!-- Suffixes default to _quat, _gyro, _accel which match our MJCF sensors -->
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>

  </ros2_control>

</robot>
