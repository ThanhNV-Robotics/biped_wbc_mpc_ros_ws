<mujoco model="free_foot_test">
    <option gravity="0 0 -9.81" timestep="0.001" />
    <compiler angle="degree" meshdir="meshes/" autolimits="true" />

    <statistic center="0 0 0.5" extent="1.0" meansize="0.05" />

    <contact>
        <pair geom1="floor" geom2="Left_Foot"  solimp="0.9 0.95 0.0001" solref="0.001 1" />
        <pair geom1="floor" geom2="Right_Foot" solimp="0.9 0.95 0.0001" solref="0.001 1" />
    </contact>

    <default>
        <default class="visual">
            <geom contype="0" conaffinity="0" group="0" density="0" rgba="0.5 0.5 0.5 1" />
        </default>
    </default>

    <asset>
        <mesh name="link0_torso"           file="link0_torso.stl"           scale="0.001 0.001 0.001" />
        <mesh name="left_ankle_pitch_link" file="left_ankle_pitch_link.stl" scale="0.001 0.001 0.001" />
        <mesh name="right_ankle_pitch_link" file="right_ankle_pitch_link.stl" scale="0.001 0.001 0.001" />

        <texture type="2d" name="groundplane" builtin="checker" mark="random"
            rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25"
            markrgb="0.6 0.7 0.8" width="512" height="512"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
    </asset>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="-140" elevation="-20" />
    </visual>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

        <!-- Torso: fixed to world at standing height -->
        <body name="link0_torso" pos="0 0 0.765">
            <geom type="mesh" class="visual" mesh="link0_torso" />
            <inertial pos="0.022E-3 0.011E-3 -9.359E-3" mass="5.721"
                fullinertia="1.338E-1 1.019E-1 6.278E-2 -7542.256E-9 8599.288E-9 8566.243E-9"/>
            <site name="torso_imu" type="box" pos="0.02 0 0.02" size="0.01 0.01 0.01" rgba="1 0 0 1"/>
        </body>

        <!-- Left foot: free-floating body, starts at standing foot position -->
        <body name="left_foot_body" pos="0 0.15 0.1">
            <joint type="free" name="left_foot_free"/>
            <geom name="Left_Foot" type="mesh" mesh="left_ankle_pitch_link"
                friction="5.0 0.1 0.1" rgba="0.2 0.6 0.9 1"/>
            <inertial pos="29.106E-3 0 -30.483E-3" mass="343.229E-3"
                fullinertia="1.546E-4 8.770E-4 9.434E-4 -9.97E-9 50230.908E-9 40.36E-9"/>
        </body>

        <!-- Right foot: free-floating body, starts at standing foot position -->
        <body name="right_foot_body" pos="0 -0.15 0.1">
            <joint type="free" name="right_foot_free"/>
            <geom name="Right_Foot" type="mesh" mesh="right_ankle_pitch_link"
                friction="5.0 0.1 0.1" rgba="0.9 0.5 0.2 1"/>
            <inertial pos="29.106E-3 0 -30.483E-3" mass="343.229E-3"
                fullinertia="1.546E-4 8.770E-4 9.434E-4 -9.97E-9 50230.908E-9 40.36E-9"/>
        </body>
    </worldbody>

    <sensor>
        <framequat name="torso_quat"  objtype="site" objname="torso_imu" />
        <accelerometer name="torso_accel" site="torso_imu"/>
        <gyro          name="torso_gyro"  site="torso_imu"/>
    </sensor>
</mujoco>
