<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>biped_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and controller configuration for the biped (real robot and MuJoCo simulation)</description>
  <maintainer email="thanhnguyenvan0596@gmail.com">humanoid</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- robot description, hardware plugin + xacro, simulation -->
  <exec_depend>biped_description</exec_depend>
  <exec_depend>biped_hardware</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- controllers started by the launch files -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>biped_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <!-- tools and visualization -->
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- scripts/odom_to_tf.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
