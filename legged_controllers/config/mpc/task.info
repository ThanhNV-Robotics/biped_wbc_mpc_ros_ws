  (1,1)   5.0     ; h_com_y / robotMass
  (2,2)   50.0    ; h_com_z / robotMass
  (3,3)   0.5     ; L_x / robotMass
  (4,4)   0.5     ; L_y / robotMass
  (5,5)   0.5     ; L_z / robotMass

  ;; Base Pose: [position, orientation] ;;
  (6,6)   10.0   ; p_base_x
  (7,7)   10.0   ; p_base_y
  (8,8)   500.0  ; p_base_z
  ; euler angles for base to world rotation
  (9,9)   100.0  ; theta_base_z  (yaw)
  (10,10) 200.0  ; theta_base_y  (pitch)
  (11,11) 200.0  ; theta_base_x  (roll)

  ;; Joint Positions ;;
  (12,12) 5.0   ;    left_hip_pitch_joint
  (13,13) 5.0   ;    left_hip_roll_joint
  (14,14) 5.0   ;    left_hip_yaw_joint
  (15,15) 5.0   ;    left_knee_pitch_joint
