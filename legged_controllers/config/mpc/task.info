  (22,22) 5.0   ;    right_ankle_roll_joint
  (23,23) 5.0   ;    right_ankle_pitch_joint
}

; control weight matrix
; Layout: inputDim = 3*numContacts3DoF + actuatedDof = 3*2 + 12 = 18
;   (0,0)-(5,5)   : 3-DoF contact forces, 2 feet × [fx, fy, fz]
;   (6,6)-(17,17) : 12 joint velocities
R
{
  scaling 1e-3

  ;; 3-DoF Contact Forces: 2 feet × 3 = 6 entries ;;
  (0,0)   0.1       ; left_foot  fx
  (1,1)   0.1       ; left_foot  fy
  (2,2)   0.1       ; left_foot  fz
  (3,3)   0.1       ; right_foot fx
  (4,4)   0.1       ; right_foot fy
  (5,5)   0.1       ; right_foot fz

  ;; Joint Velocities: 12 joints (entries 6-17) ;;
  (6,6)   0.1     ;    left_hip_pitch_joint
  (7,7)   0.1     ;    left_hip_roll_joint
  (8,8)   0.1     ;    left_hip_yaw_joint
  (9,9)   0.1     ;    left_knee_pitch_joint
  (10,10) 0.1     ;    left_ankle_roll_joint
  (11,11) 0.1     ;    left_ankle_pitch_joint
  (12,12) 0.1     ;    right_hip_pitch_joint
  (13,13) 0.1     ;    right_hip_roll_joint
  (14,14) 0.1     ;    right_hip_yaw_joint
  (15,15) 0.1     ;    right_knee_pitch_joint
  (16,16) 0.1     ;    right_ankle_roll_joint
  (17,17) 0.1     ;    right_ankle_pitch_joint
}

