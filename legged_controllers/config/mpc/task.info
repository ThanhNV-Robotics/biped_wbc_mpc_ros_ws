model_settings
{
  robotName                      biped_robot

  foot_constraint
  {
    ; STEP 1: set to 0 - contact frame z is wrong in CppAD (z=0 vs z=-0.05)
    ; positionErrorGain_z * (ankle_height - 0) commands ankle downward at 0.25m/s
    positionErrorGain_z             0.0
    orientationErrorGain            0.0
    linearVelocityErrorGain_z       0.0
    linearVelocityErrorGain_xy      0.0
    angularVelocityErrorGain        0.0
    linearAccelerationErrorGain_z   0.0
    linearAccelerationErrorGain_xy  0.0
    angularAccelerationErrorGain    0.0
  }

  phaseTransitionStanceTime       0.0

  verboseCppAd                  true
  ; Set to true on first run (or after changing robot model) to regenerate CppAD code.
  ; Set to false after the libraries are compiled to skip recompilation on startup.
  recompileLibrariesCppAd       false
  ; Absolute path — relative paths resolve from the ros2_control_node working
  ; directory which is unpredictable and causes stale-library loading issues.
  modelFolderCppAd              /home/vanthanhnguyen/Documents/Programs/biped_wbc_mpc_ws/cppad_generated/biped_robot_12dof

  ; Active joints included in the MPC model (all others in URDF will be fixed)
  jointNames
  {
    [0]  "left_hip_pitch_joint"
    [1]  "left_hip_roll_joint"
    [2]  "left_hip_yaw_joint"
    [3]  "left_knee_pitch_joint"
    [4]  "left_ankle_roll_joint"
    [5]  "left_ankle_pitch_joint"
    [6]  "right_hip_pitch_joint"
    [7]  "right_hip_roll_joint"
    [8]  "right_hip_yaw_joint"
    [9]  "right_knee_pitch_joint"
    [10] "right_ankle_roll_joint"
    [11] "right_ankle_pitch_joint"
  }

  ; 3-DoF contact frame names (used by state estimator Kalman filter)
  contactNames3DoF
  {
    [0] "left_ankle_pitch_link"
    [1] "right_ankle_pitch_link"
  }

  ; Pinocchio Frame names for the 6-DoF contact frames (MPC foot pose constraints)
  contactNames6DoF
  {
  }

  ; The Parent frames on which the contact frames are added. 
  contactParentJointNames
  {
    [0] "left_ankle_pitch_joint"
    [1] "right_ankle_pitch_joint"
  }

  ;; Map arm swing reference to hip joints since biped_robot_12dof has no arms
  armJointNames {
    left_shoulder_y       left_hip_pitch_joint
    right_shoulder_y      right_hip_pitch_joint
    left_elbow_y          left_hip_roll_joint
    right_elbow_y         right_hip_roll_joint
  }

}


